# Django Settings
SECRET_KEY=your-secret-key-here-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database
POSTGRES_DB=agendacero_db
POSTGRES_USER=agendacero_user
POSTGRES_PASSWORD=agendacero_password
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgres://agendacero_user:agendacero_password@db:5432/agendacero_db

# JWT Settings
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7
JWT_AUTH_COOKIE=jwt-auth

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

# API Version
API_VERSION=v1
